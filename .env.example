# Everything here is OPTIONAL. CV Tracker works with no keys at all.
# Copy this file to .env, fill in what you want, then restart `npm run dev`. Never commit .env.

# ---------------------------------------------------------------------------
# Free AI tools: smart CV reading, fit check, cover letter, interview prep, CV tailoring.
# Pick one (or several: if one is busy or out of quota, the next is tried).
# All of these have free tiers and need no credit card.
# ---------------------------------------------------------------------------

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (fast, generous free tier): https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (the default model is its free router): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama: runs on your own computer, 100% free and private. Install from https://ollama.com,
# run `ollama pull llama3.2`, then set the model name here.
OLLAMA_MODEL=
# OLLAMA_HOST=http://localhost:11434

# Optional overrides
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=
# Any other OpenAI-compatible API:
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
# Max AI requests per visitor per hour (protects your free quota if you deploy this publicly)
# AI_RATE_LIMIT=40

# ---------------------------------------------------------------------------
# Local on-site jobs in your country (the free remote boards rarely list these).
# ---------------------------------------------------------------------------

# Jooble (free, covers Nigeria and 70+ countries): https://jooble.org/api/about
JOOBLE_KEY=

# Adzuna (free; UK, US, CA, AU, DE, FR, IN, ZA, NL, PL, SG and more): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
